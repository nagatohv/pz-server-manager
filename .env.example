# --- CONFIGURACIÓN DEL PORTAL WEB ---

# Puerto en el que corre el panel web (por defecto: 3000)
PORT=3000

# Contraseña de acceso maestro para el panel web (¡Cámbiame!)
ADMIN_PASSWORD=admin

# Clave secreta para firmar los tokens de sesión JWT
JWT_SECRET=super-secret-pz-token-key-change-me

# --- DIRECTORIO DE DATOS PERSISTENTES ---
# En producción (Docker/Dokploy), este valor debe ser /home/steam/data
# Para desarrollo local (Windows/Mac), puedes usar una ruta relativa.
# Dentro de este directorio se crea el subdirectorio instances/ con cada servidor.
DATA_DIR=./data

# --- MULTI-INSTANCIA ---
# El portal arranca SIN servidores. El operador crea la primera instancia desde
# la pestaña "Servidores" del portal. Cada instancia se descarga solo cuando
# el operador pulsa "Instalar / Actualizar" en la instancia correspondiente.

# Lista de respaldo de ramas (formato JSON) usada cuando SteamCMD no devuelve
# ramas en /api/branches. Cadena vacía = rama pública por defecto.
# STEAM_FALLBACK_BRANCHES=[{"name":"","description":"Rama Pública (Build 41)","isDefault":true},{"name":"b42stable","description":"Build 42 Estable"},{"name":"unstable","description":"Build 42 Inestable","isUnstable":true}]

# Timeout (ms) para la consulta de ramas a SteamCMD
# STEAMCMD_BRANCH_DISCOVERY_TIMEOUT_MS=1800000
